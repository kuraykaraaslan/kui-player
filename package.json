{
  "name": "@kuraykaraaslan/kui-player",
  "version": "0.1.0",
  "description": "Standalone video player \u2014 vanilla TS core + React subpath. Native <video> playback with optional hls.js/dash.js adapters, custom subtitle overlay, speed control, Picture-in-Picture, touch gestures, Google Cast, fullscreen, keyboard shortcuts.",
  "keywords": [
    "video",
    "player",
    "react",
    "typescript",
    "hls",
    "dash",
    "chromecast",
    "subtitles",
    "picture-in-picture",
    "kui"
  ],
  "license": "Apache-2.0",
  "author": "Kuray Karaaslan <kuraykaraaslan@gmail.com>",
  "homepage": "https://github.com/kuraykaraaslan/kui-player#readme",
  "bugs": {
    "url": "https://github.com/kuraykaraaslan/kui-player/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuraykaraaslan/kui-player.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/modules/index.d.ts",
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react/index.d.ts"
      ],
      "skin": [
        "./dist/embed/skin.d.ts"
      ],
      "locales": [
        "./dist/react/i18n/locales/index.d.ts"
      ],
      "wrappers/vue": [
        "./dist/wrappers/vue/KuiPlayer.d.ts"
      ],
      "wrappers/svelte": [
        "./dist/wrappers/svelte/kuiPlayer.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/modules/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./skin": {
      "types": "./dist/embed/skin.d.ts",
      "import": "./dist/skin/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./locales": {
      "types": "./dist/react/i18n/locales/index.d.ts",
      "import": "./dist/locales/index.js"
    },
    "./wrappers/vue": {
      "types": "./dist/wrappers/vue/KuiPlayer.d.ts",
      "import": "./dist/wrappers/vue.js"
    },
    "./wrappers/svelte": {
      "types": "./dist/wrappers/svelte/kuiPlayer.d.ts",
      "import": "./dist/wrappers/svelte.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "size-limit": [
    {
      "name": "core (vanilla engine)",
      "path": "dist/index.js",
      "limit": "12.5 kB"
    },
    {
      "name": "react subpath",
      "path": [
        "dist/react/index.js",
        "dist/react/player.js"
      ],
      "limit": "27 kB"
    },
    {
      "name": "react subpath + every lazy chunk",
      "path": [
        "dist/react/index.js",
        "dist/react/player.js",
        "dist/react/SettingsPanel.js",
        "dist/react/AboutModal.js",
        "dist/react/CastController.js",
        "dist/react/videoplayer.meta.js"
      ],
      "limit": "34 kB"
    },
    {
      "name": "embed (single script)",
      "path": "dist/embed.js",
      "limit": "39 kB"
    },
    {
      "name": "stylesheet",
      "path": "dist/styles.css",
      "limit": "5.5 kB"
    },
    {
      "name": "skin mode (bundler entry)",
      "path": [
        "dist/skin/index.js",
        "dist/skin/skin.js"
      ],
      "limit": "28.5 kB"
    },
    {
      "name": "locales (all six)",
      "path": [
        "dist/locales/index.js"
      ],
      "limit": "6 kB"
    }
  ],
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "axe-core": "^4.13.0",
    "esbuild": "^0.21.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.0.0",
    "preact": "^10.29.8",
    "publint": "^0.3.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svelte": "^5.57.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.9",
    "vue": "^3.5.42"
  },
  "scripts": {
    "dev": "vite --config vite.config.demo.ts",
    "build:js": "vite build && vite build --config vite.config.react.ts && vite build --config vite.config.skin.ts && vite build --config vite.config.locales.ts && vite build --config vite.config.wrappers.ts",
    "build:types": "tsc -p tsconfig.lib.json",
    "build:css": "node scripts/build-css.mjs",
    "build:embed": "vite build --config vite.config.embed.ts",
    "build": "pnpm build:js && pnpm build:types && pnpm build:css && pnpm build:embed",
    "size": "node scripts/check-size.mjs",
    "build:demo": "vite build --config vite.config.demo.ts",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "check:release": "pnpm build && pnpm check:artifacts && pnpm check:package && pnpm size"
  }
}
