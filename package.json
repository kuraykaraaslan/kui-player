{
  "name": "@kuraykaraaslan/kui-player",
  "version": "0.0.2",
  "description": "Standalone video player — vanilla TS core + React subpath. Native <video> playback with optional hls.js/dash.js adapters, custom subtitle overlay, speed control, Picture-in-Picture, touch gestures, Google Cast, fullscreen, keyboard shortcuts.",
  "keywords": [
    "video",
    "player",
    "react",
    "typescript",
    "hls",
    "dash",
    "chromecast",
    "subtitles",
    "picture-in-picture",
    "kui"
  ],
  "license": "Apache-2.0",
  "author": "Kuray Karaaslan <kuraykaraaslan@gmail.com>",
  "homepage": "https://github.com/kuraykaraaslan/kui-player#readme",
  "bugs": {
    "url": "https://github.com/kuraykaraaslan/kui-player/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuraykaraaslan/kui-player.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/modules/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/modules/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "size-limit": [
    {
      "name": "core (vanilla engine)",
      "path": "dist/index.js",
      "limit": "9 kB"
    },
    {
      "name": "react subpath",
      "path": [
        "dist/react/index.js",
        "dist/react/player.js"
      ],
      "limit": "20 kB"
    },
    {
      "name": "react subpath + lazy chunks",
      "path": [
        "dist/react/index.js",
        "dist/react/player.js",
        "dist/react/SettingsPanel.js",
        "dist/react/AboutModal.js",
        "dist/react/CastController.js",
        "dist/react/videoplayer.meta.js"
      ],
      "limit": "26 kB"
    },
    {
      "name": "embed (single script)",
      "path": "dist/embed.js",
      "limit": "35 kB"
    },
    {
      "name": "stylesheet",
      "path": "dist/styles.css",
      "limit": "4 kB"
    }
  ],
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "postcss": "^8.0.0",
    "preact": "^10.29.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "scripts": {
    "dev": "vite --config vite.config.demo.ts",
    "build:js": "vite build && vite build --config vite.config.react.ts",
    "build:types": "tsc -p tsconfig.lib.json",
    "build:css": "node scripts/build-css.mjs",
    "build:embed": "vite build --config vite.config.embed.ts",
    "build": "pnpm build:js && pnpm build:types && pnpm build:css && pnpm build:embed",
    "size": "node scripts/check-size.mjs",
    "build:demo": "vite build --config vite.config.demo.ts",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json"
  }
}
